[Unit]
Description=Selected audio arrival processing (local ASR and compression)
After=docker.service life-atlas-whatsapp-sync.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=life-atlas-audio-intake
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/life-atlas-audio-intake/docker
ExecStartPre=/usr/bin/install -d -m 700 /run/life-atlas-audio-intake/docker
ExecStart=/usr/bin/python3 -B /opt/life-atlas-audio/automation.py scan
TimeoutStartSec=24h
TimeoutStopSec=45s
KillSignal=SIGTERM
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=512M
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ReadWritePaths=/srv/audio-archive/automation /srv/audio-archive/staging /srv/audio-archive/transcription-batches /srv/audio-archive/transcription-control
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
